<?xml version="1.0"?>
<!DOCTYPE package-info SYSTEM "http://www.simplemachines.org/xml/package-info">
<package-info xmlns="http://www.simplemachines.org/xml/package-info">
	<id>digger:who_downloaded_attachment</id>
	<name>Who Downloaded Attachment</name>
	<type>modification</type>
	<version>1.1.3</version>

	<install for="2.0 - 2.0.99">
		<readme parsebbc="true">README.bbc</readme>
		<require-dir name="Sources" destination="$boarddir"/>
		<require-dir name="Common/Themes" destination="$boarddir"/>
		<require-dir name="SMF20/Themes" destination="$boarddir"/>
		<modification>modification20.xml</modification>
		<database>database.php</database>
		<database>hooks.php</database>
		<redirect url="?action=admin;area=permissions;" timeout="5000"/>
	</install>

	<uninstall for="2.0 - 2.0.99">
		<remove-dir name="$languagedir/WhoDownloaded"/>
		<remove-file name="$themedir/scripts/WhoDownloadedAttachment.js"/>
		<remove-file name="$themedir/css/WhoDownloadedAttachment.css"/>
		<remove-file name="$themedir/WhoDownloadedAttachment.template.php"/>
		<remove-file name="$sourcedir/Mod-WhoDownloadedAttachment.php"/>
		<modification reverse="true">modification20.xml</modification>
		<code>hooks.php</code>
	</uninstall>

	<install for="2.1.*">
		<readme parsebbc="true">README.bbc</readme>
		<require-dir name="Sources" destination="$boarddir"/>
		<require-dir name="Common/Themes" destination="$boarddir"/>
		<require-dir name="SMF21/Themes" destination="$boarddir"/>
		<database>database.php</database>
		<database>hooks.php</database>
		<redirect url="?action=admin;area=permissions;" timeout="5000"/>
	</install>

	<uninstall for="2.1.*">
		<remove-dir name="$languagedir/WhoDownloaded"/>
		<remove-file name="$themedir/scripts/WhoDownloadedAttachment.js"/>
		<remove-file name="$themedir/css/WhoDownloadedAttachment.css"/>
		<remove-file name="$themedir/WhoDownloadedAttachment.template.php"/>
		<remove-file name="$sourcedir/Mod-WhoDownloadedAttachment.php"/>
		<code>hooks.php</code>
	</uninstall>
</package-info>
